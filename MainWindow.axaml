<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:Yolcu360Otomasyon.Models"
        mc:Ignorable="d"
        d:DesignWidth="1360"
        d:DesignHeight="860"
        x:Class="Yolcu360Otomasyon.MainWindow"
        Title="Yolcu360 Otomasyon"
        Width="1360"
        Height="860"
        Background="#F4F7FB">
    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="CaretBrush" Value="#132235" />
            <Setter Property="BorderBrush" Value="#D6DFEA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="TextBox:focus">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="BorderBrush" Value="#0F62FE" />
        </Style>

        <Style Selector="TextBox:pointerover">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#132235" />
        </Style>

        <Style Selector="TextBox /template/ ScrollViewer">
            <Setter Property="Background" Value="White" />
        </Style>

        <Style Selector="TextBox /template/ Border">
            <Setter Property="Background" Value="White" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="BorderBrush" Value="#D6DFEA" />
        </Style>

        <Style Selector="ComboBox:focus">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="BorderBrush" Value="#0F62FE" />
        </Style>

        <Style Selector="CalendarDatePicker.search-picker">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="0,7" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>

        <Style Selector="CalendarDatePicker.search-picker:focus">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="CalendarDatePicker.search-picker:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="CalendarDatePicker.search-picker TextBlock">
            <Setter Property="Foreground" Value="#132235" />
        </Style>

        <Style Selector="CalendarDatePicker.search-picker /template/ Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>

        <Style Selector="CalendarDatePicker.search-picker /template/ Button:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="CalendarDatePicker.search-picker /template/ Button:pressed">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="Calendar">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#132235" />
        </Style>

        <Style Selector="Calendar /template/ Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D6DFEA" />
        </Style>

        <Style Selector="CalendarDayButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="CalendarDayButton:pointerover">
            <Setter Property="Background" Value="#EEF4FF" />
            <Setter Property="Foreground" Value="#0F62FE" />
            <Setter Property="BorderBrush" Value="#CFE0FF" />
        </Style>

        <Style Selector="CalendarDayButton:selected">
            <Setter Property="Background" Value="#0F62FE" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#0F62FE" />
        </Style>

        <Style Selector="CalendarDayButton:disabled">
            <Setter Property="Foreground" Value="#A4B1C0" />
        </Style>

        <Style Selector="CalendarButton">
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="CalendarButton:pointerover">
            <Setter Property="Background" Value="#EEF4FF" />
            <Setter Property="Foreground" Value="#0F62FE" />
        </Style>

        <Style Selector="DatePickerPresenter">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D6DFEA" />
        </Style>

        <Style Selector="ComboBox.search-picker">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="BorderBrush" Value="#D6DFEA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style Selector="ComboBox.search-picker:focus">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="BorderBrush" Value="#0F62FE" />
        </Style>

        <Style Selector="ComboBox.search-picker TextBlock">
            <Setter Property="Foreground" Value="#132235" />
        </Style>

        <Style Selector="PopupRoot">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#0F62FE" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#0F62FE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#0B57E3" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#0B57E3" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.primary:pressed">
            <Setter Property="Background" Value="#0847BC" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#0847BC" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.primary:disabled">
            <Setter Property="Background" Value="#9DBCFB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#9DBCFB" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.primary /template/ ContentPresenter">
            <Setter Property="TextElement.Foreground" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.primary /template/ Border">
            <Setter Property="Background" Value="#0F62FE" />
            <Setter Property="BorderBrush" Value="#0F62FE" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.primary:pointerover /template/ Border">
            <Setter Property="Background" Value="#0B57E3" />
            <Setter Property="BorderBrush" Value="#0B57E3" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.primary:pressed /template/ Border">
            <Setter Property="Background" Value="#0847BC" />
            <Setter Property="BorderBrush" Value="#0847BC" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#DC2626" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.danger:pointerover">
            <Setter Property="Background" Value="#B91C1C" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#B91C1C" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.danger:pressed">
            <Setter Property="Background" Value="#991B1B" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#991B1B" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.danger /template/ ContentPresenter">
            <Setter Property="TextElement.Foreground" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.danger /template/ Border">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="BorderBrush" Value="#DC2626" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.danger:pointerover /template/ Border">
            <Setter Property="Background" Value="#B91C1C" />
            <Setter Property="BorderBrush" Value="#B91C1C" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.danger:pressed /template/ Border">
            <Setter Property="Background" Value="#991B1B" />
            <Setter Property="BorderBrush" Value="#991B1B" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.btn-sm">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.btn-secondary">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.btn-secondary:pointerover">
            <Setter Property="Background" Value="#EDF2F7" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#94A3B8" />
        </Style>

        <Style Selector="Button.btn-secondary:pressed">
            <Setter Property="Background" Value="#E2E8F0" />
            <Setter Property="Foreground" Value="#0F172A" />
        </Style>

        <Style Selector="Button.btn-secondary /template/ ContentPresenter">
            <Setter Property="TextElement.Foreground" Value="#334155" />
        </Style>

        <Style Selector="Button.btn-secondary:pointerover /template/ ContentPresenter">
            <Setter Property="TextElement.Foreground" Value="#0F172A" />
        </Style>

        <Style Selector="Button.btn-secondary /template/ Border">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
        </Style>

        <Style Selector="Button.btn-secondary:pointerover /template/ Border">
            <Setter Property="Background" Value="#EDF2F7" />
            <Setter Property="BorderBrush" Value="#94A3B8" />
        </Style>

        <Style Selector="Button.btn-secondary:pressed /template/ Border">
            <Setter Property="Background" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#94A3B8" />
        </Style>

        <Style Selector="Button.btn-danger-subtle">
            <Setter Property="Background" Value="#FEF2F2" />
            <Setter Property="Foreground" Value="#DC2626" />
            <Setter Property="BorderBrush" Value="#FECACA" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.btn-danger-subtle:pointerover">
            <Setter Property="Background" Value="#FEE2E2" />
            <Setter Property="Foreground" Value="#B91C1C" />
            <Setter Property="BorderBrush" Value="#FCA5A5" />
        </Style>

        <Style Selector="Button.btn-danger-subtle:pressed">
            <Setter Property="Background" Value="#FECACA" />
            <Setter Property="Foreground" Value="#991B1B" />
        </Style>

        <Style Selector="Button.btn-danger-subtle /template/ ContentPresenter">
            <Setter Property="TextElement.Foreground" Value="#DC2626" />
        </Style>

        <Style Selector="Button.btn-danger-subtle:pointerover /template/ ContentPresenter">
            <Setter Property="TextElement.Foreground" Value="#B91C1C" />
        </Style>

        <Style Selector="Button.btn-danger-subtle /template/ Border">
            <Setter Property="Background" Value="#FEF2F2" />
            <Setter Property="BorderBrush" Value="#FECACA" />
        </Style>

        <Style Selector="Button.btn-danger-subtle:pointerover /template/ Border">
            <Setter Property="Background" Value="#FEE2E2" />
            <Setter Property="BorderBrush" Value="#FCA5A5" />
        </Style>

        <Style Selector="Button.btn-danger-subtle:pressed /template/ Border">
            <Setter Property="Background" Value="#FECACA" />
            <Setter Property="BorderBrush" Value="#FCA5A5" />
        </Style>

        <Style Selector="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="BorderBrush" Value="#D6DFEA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF3F9" />
            <Setter Property="Foreground" Value="#233143" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,8" />
        </Style>

        <Style Selector="DataGridRow">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="MinHeight" Value="42" />
        </Style>

        <Style Selector="DataGridRow:pointerover">
            <Setter Property="Background" Value="#F8FBFF" />
            <Setter Property="Foreground" Value="#132235" />
        </Style>

        <Style Selector="DataGridCell">
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#E8EEF5" />
            <Setter Property="Padding" Value="8,6" />
        </Style>

        <Style Selector="DataGridCell:current">
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="Background" Value="#EEF4FF" />
        </Style>

        <Style Selector="DataGridCell TextBlock">
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <Grid>
        <Border x:Name="LoginView"
                Margin="28"
                Background="White"
                BorderBrush="#D9E2EC"
                BorderThickness="1"
                CornerRadius="10"
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="460">
            <StackPanel Spacing="18">
                <StackPanel Spacing="6">
                    <TextBlock Text="Giriş Yap"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#122033" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Email"
                               Foreground="#243446"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="LoginEmailTextBox"
                             PlaceholderText="mail@example.com" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Şifre"
                               Foreground="#243446"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="LoginPasswordTextBox"
                             PasswordChar="•"
                             PlaceholderText="Uygulama şifresi" />
                </StackPanel>

                <Button x:Name="LoginButton"
                        Classes="primary"
                        Content="Giriş Yap"
                        Click="LoginButton_Click" />

                <Button x:Name="GoToRegisterButton"
                        Content="Kayıt Ol"
                        Click="GoToRegisterButton_Click" />

                <TextBlock x:Name="StatusTextBlock"
                           Text="Hazır"
                           TextWrapping="Wrap"
                           Foreground="#132235"
                           FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <Border x:Name="RegisterView"
                IsVisible="False"
                Margin="28"
                Background="White"
                BorderBrush="#D9E2EC"
                BorderThickness="1"
                CornerRadius="10"
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="460">
            <StackPanel Spacing="18">
                <StackPanel Spacing="6">
                    <TextBlock Text="Kayıt Ol"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#122033" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Email"
                               Foreground="#243446"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="RegisterEmailTextBox"
                             PlaceholderText="mail@example.com" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Şifre"
                               Foreground="#243446"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="RegisterPasswordTextBox"
                             PasswordChar="•"
                             PlaceholderText="Uygulama şifresi" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Telefon numarası"
                               Foreground="#243446"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="RegisterPhoneNumberTextBox"
                             PlaceholderText="5xxxxxxxxx" />
                </StackPanel>

                <Button x:Name="RegisterButton"
                        Classes="primary"
                        Content="Kaydol ve Giriş Yap"
                        Click="RegisterButton_Click" />

                <Button x:Name="BackToLoginButton"
                        Content="Giriş Sayfasına Dön"
                        Click="BackToLoginButton_Click" />

                <TextBlock x:Name="RegisterStatusTextBlock"
                           Text=""
                           TextWrapping="Wrap"
                           Foreground="#132235"
                           FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="MainView"
                      IsVisible="False"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid Margin="28"
                  RowDefinitions="Auto,*"
                  RowSpacing="20">
                <Border Background="#0F172A"
                        CornerRadius="10"
                        Padding="28">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="24">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Yolcu360 Operasyon Paneli"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="White" />

                            <TextBlock Text="Kayıtlı oturumla arama ve sonuç akışını yönetin."
                                       FontSize="15"
                                       Foreground="#C7D2E4" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                x:Name="LogoutButton"
                                Classes="danger"
                                Content="Çıkış Yap"
                                Width="120"
                                VerticalAlignment="Center"
                                Click="LogoutButton_Click" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1"
                      RowDefinitions="Auto,Auto,*"
                      RowSpacing="20">
                    <StackPanel x:Name="TopNavigationPanel"
                                Orientation="Horizontal"
                                Spacing="10">
                        <Button x:Name="SearchTabButton"
                                Classes="primary"
                                Content="Araç Kirala"
                                Width="160"
                                Click="SearchTabButton_Click" />
                        <Button x:Name="FlightTabButton"
                                Content="Uçak Bileti"
                                Width="160"
                                Click="FlightTabButton_Click" />
                        <Button x:Name="HistoryTabButton"
                                Content="Geçmiş Kayıtlar"
                                Width="180"
                                Click="HistoryTabButton_Click" />
                        <Button x:Name="PaymentsTabButton"
                                Content="Ödemeler"
                                Width="160"
                                Click="PaymentsTabButton_Click" />
                        <!-- Extra - Statistics START -->
                        <Button x:Name="StatisticsTabButton"
                                Content="İstatistikler"
                                Width="160"
                                Click="StatisticsTabButton_Click" />
                        <!-- Extra - Statistics END -->
                    </StackPanel>

                    <Border Grid.Row="1"
                            Grid.RowSpan="2"
                            x:Name="SearchPanel"
                            Background="White"
                            BorderBrush="#D9E2EC"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="22">
                        <Grid ColumnDefinitions="430,*"
                              ColumnSpacing="18">
                        <StackPanel Grid.Column="0"
                                    Spacing="18">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Arama ve Filtreleme"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#122033" />
                            </StackPanel>

                            <TextBlock x:Name="SearchStatusTextBlock"
                                       Text=""
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="#132235"
                                       FontWeight="SemiBold" />

                            <StackPanel Spacing="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Alış yeri"
                                               Foreground="#243446"
                                               FontWeight="SemiBold" />
                                    <!-- Extra - Location Suggestion START -->
                                    <TextBox x:Name="PickupLocationTextBox"
                                             PlaceholderText="Düzce"
                                             Width="430"
                                             HorizontalAlignment="Left"
                                             TextChanged="PickupLocationTextBox_TextChanged" />
                                    <Border x:Name="PickupLocationSuggestionsPanel"
                                            IsVisible="False"
                                            Background="White"
                                            BorderBrush="#D6DFEA"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Margin="0,-2,0,0"
                                            Width="430"
                                            HorizontalAlignment="Left"
                                            MaxHeight="220">
                                        <ListBox x:Name="PickupLocationSuggestionsListBox"
                                                 Background="White"
                                                 SelectionChanged="PickupLocationSuggestionsListBox_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:LocationSuggestionItem">
                                                    <Border Padding="10,8">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{Binding MainText}"
                                                                       Foreground="#132235"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding SecondaryText}"
                                                                       Foreground="#5F7187"
                                                                       FontSize="12" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                    <!-- Extra - Location Suggestion END -->
                                </StackPanel>

                                <!-- Extra - Dropoff Location START -->
                                <!-- Optional different dropoff location field and Yolcu360-compatible suggestions. -->
                                <StackPanel Spacing="8">
                                    <CheckBox x:Name="DifferentDropoffCheckBox"
                                              Content="Aracı farklı bir yere bırakacağım"
                                              Foreground="#243446"
                                              IsCheckedChanged="DifferentDropoffCheckBox_Changed" />

                                    <StackPanel x:Name="DropoffLocationPanel"
                                                IsVisible="False"
                                                Spacing="6">
                                        <TextBlock Text="Bırakış yeri"
                                                   Foreground="#243446"
                                                   FontWeight="SemiBold" />
                                        <TextBox x:Name="DropoffLocationTextBox"
                                                 PlaceholderText="İstanbul Havalimanı"
                                                 Width="430"
                                                 HorizontalAlignment="Left"
                                                 TextChanged="DropoffLocationTextBox_TextChanged" />
                                        <Border x:Name="DropoffLocationSuggestionsPanel"
                                                IsVisible="False"
                                                Background="White"
                                                BorderBrush="#D6DFEA"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Margin="0,-2,0,0"
                                                Width="430"
                                                HorizontalAlignment="Left"
                                                MaxHeight="220">
                                            <ListBox x:Name="DropoffLocationSuggestionsListBox"
                                                     Background="White"
                                                     SelectionChanged="DropoffLocationSuggestionsListBox_SelectionChanged">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="models:LocationSuggestionItem">
                                                        <Border Padding="10,8">
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Text="{Binding MainText}"
                                                                           Foreground="#132235"
                                                                           FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding SecondaryText}"
                                                                           Foreground="#5F7187"
                                                                           FontSize="12" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <!-- Extra - Dropoff Location END -->

                                <Grid ColumnDefinitions="Auto,Auto"
                                      ColumnSpacing="75"
                                      HorizontalAlignment="Left">
                                    <StackPanel Spacing="14">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Alış tarihi"
                                                       Foreground="#243446"
                                                       FontWeight="SemiBold" />
                                            <Grid>
                                            <Border x:Name="PickupDateBox"
                                                    Width="142"
                                                    Height="38"
                                                    Background="White"
                                                    BorderBrush="#D6DFEA"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    PointerPressed="PickupDateBox_PointerPressed">
                                                <TextBlock x:Name="PickupDateTextBlock"
                                                           VerticalAlignment="Center"
                                                           Margin="12,0"
                                                           Foreground="#132235"
                                                           FontSize="16" />
                                            </Border>
                                                <CalendarDatePicker x:Name="PickupDatePicker"
                                                                    Classes="search-picker"
                                                                    Width="1"
                                                                    HorizontalAlignment="Left"
                                                                    Height="1"
                                                                    Opacity="0"
                                                                    SelectedDateChanged="SearchDatePicker_SelectedDateChanged" />
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Alış saati"
                                                       Foreground="#243446"
                                                       FontWeight="SemiBold" />
                                            <ComboBox x:Name="PickupTimeComboBox"
                                                      Classes="search-picker"
                                                      Width="92"
                                                      HorizontalAlignment="Left"
                                                      Height="38" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Spacing="14">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Dönüş tarihi"
                                                       Foreground="#243446"
                                                       FontWeight="SemiBold" />
                                            <Grid>
                                            <Border x:Name="ReturnDateBox"
                                                    Width="142"
                                                    Height="38"
                                                    Background="White"
                                                    BorderBrush="#D6DFEA"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    PointerPressed="ReturnDateBox_PointerPressed">
                                                <TextBlock x:Name="ReturnDateTextBlock"
                                                           VerticalAlignment="Center"
                                                           Margin="12,0"
                                                           Foreground="#132235"
                                                           FontSize="16" />
                                            </Border>
                                                <CalendarDatePicker x:Name="ReturnDatePicker"
                                                                    Classes="search-picker"
                                                                    Width="1"
                                                                    HorizontalAlignment="Left"
                                                                    Height="1"
                                                                    Opacity="0"
                                                                    SelectedDateChanged="SearchDatePicker_SelectedDateChanged" />
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Dönüş saati"
                                                       Foreground="#243446"
                                                       FontWeight="SemiBold" />
                                            <ComboBox x:Name="ReturnTimeComboBox"
                                                      Classes="search-picker"
                                                      Width="92"
                                                      HorizontalAlignment="Left"
                                                      Height="38" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,Auto"
                                      ColumnSpacing="8"
                                      HorizontalAlignment="Left">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Vites"
                                                   Foreground="#243446"
                                                   FontWeight="SemiBold" />
                                        <ComboBox x:Name="TransmissionComboBox"
                                                  Width="180"
                                                  SelectedIndex="0">
                                            <ComboBoxItem Content="Farketmez" Tag="" />
                                            <ComboBoxItem Content="Otomatik" Tag="otomatik" />
                                            <ComboBoxItem Content="Manuel" Tag="manuel" />
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Spacing="6">
                                        <TextBlock Text="Yakıt"
                                                   Foreground="#243446"
                                                   FontWeight="SemiBold" />
                                        <ComboBox x:Name="FuelComboBox"
                                                  Width="180"
                                                  SelectedIndex="0">
                                            <ComboBoxItem Content="Farketmez" Tag="" />
                                            <ComboBoxItem Content="Dizel" Tag="dizel" />
                                            <ComboBoxItem Content="Benzin" Tag="benzin" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <Button x:Name="SearchButton"
                                    Classes="primary"
                                    Content="Ara"
                                    Click="SearchButton_Click"
                                    Width="160" />
                            <CheckBox x:Name="ShowBrowserDuringSearchCheckBox"
                                      Content="İşlem sırasında tarayıcıyı göster"
                                      IsChecked="True"
                                      Foreground="#243446" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                x:Name="SearchResultsPanel"
                                Background="White"
                                BorderBrush="#D9E2EC"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="22">
                            <Grid RowDefinitions="Auto,Auto,*"
                                  RowSpacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Arama Sonuçları"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="#122033" />
                                </StackPanel>

                                <Grid Grid.Row="1"
                                      ColumnDefinitions="*,Auto"
                                      ColumnSpacing="10"
                                      VerticalAlignment="Center">
                                    <TextBox x:Name="CollectionNameTextBox"
                                             PlaceholderText="Kaydetmek için bir koleksiyon adı girin (Örn: İzmir Seyahati)" />
                                    <Button Grid.Column="1"
                                            x:Name="SaveResultsButton"
                                            Classes="primary btn-sm"
                                            Content="Koleksiyonu Kaydet"
                                            Click="SaveResultsButton_Click" />
                                </Grid>

                                <Border Grid.Row="2"
                                        Background="#FBFDFF"
                                        BorderBrush="#E2EAF2"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="0">
                                    <Grid>
                                        <DataGrid x:Name="ResultsDataGrid"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  CanUserResizeColumns="True"
                                                  CanUserSortColumns="True"
                                                  SelectionMode="Single"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto"
                                                  VerticalAlignment="Stretch"
                                                  HorizontalAlignment="Stretch"
                                                  MinHeight="440" />
                                        <TextBlock x:Name="SearchResultsEmptyTextBlock"
                                                   Text="Sonuçları görmek için arama yapın."
                                                   IsVisible="False"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Foreground="#5F7187"
                                                   FontWeight="SemiBold" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Grid.RowSpan="2"
                            x:Name="FlightPanel"
                            IsVisible="False"
                            Background="White"
                            BorderBrush="#D9E2EC"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="22">
                        <Grid ColumnDefinitions="420,*"
                              ColumnSpacing="18">
                            <StackPanel Spacing="18">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Uçak Bileti Arama"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="#122033" />
                                </StackPanel>

                                <TextBlock x:Name="FlightStatusTextBlock"
                                           Text=""
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="#132235"
                                           FontWeight="SemiBold" />

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Nereden?"
                                               Foreground="#243446"
                                               FontWeight="SemiBold" />
                                    <TextBox x:Name="FlightFromTextBox"
                                             PlaceholderText="İstanbul Havalimanı"
                                             TextChanged="FlightFromTextBox_TextChanged" />
                                    <Border x:Name="FlightFromSuggestionsPanel"
                                            IsVisible="False"
                                            Background="White"
                                            BorderBrush="#D6DFEA"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Margin="0,-2,0,0"
                                            MaxHeight="220">
                                        <ListBox x:Name="FlightFromSuggestionsListBox"
                                                 Background="White"
                                                 SelectionChanged="FlightFromSuggestionsListBox_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:LocationSuggestionItem">
                                                    <Border Padding="10,8">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{Binding MainText}"
                                                                       Foreground="#132235"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding SecondaryText}"
                                                                       Foreground="#5F7187"
                                                                       FontSize="12" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Nereye?"
                                               Foreground="#243446"
                                               FontWeight="SemiBold" />
                                    <TextBox x:Name="FlightToTextBox"
                                             PlaceholderText="Esenboğa Havalimanı"
                                             TextChanged="FlightToTextBox_TextChanged" />
                                    <Border x:Name="FlightToSuggestionsPanel"
                                            IsVisible="False"
                                            Background="White"
                                            BorderBrush="#D6DFEA"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Margin="0,-2,0,0"
                                            MaxHeight="220">
                                        <ListBox x:Name="FlightToSuggestionsListBox"
                                                 Background="White"
                                                 SelectionChanged="FlightToSuggestionsListBox_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:LocationSuggestionItem">
                                                    <Border Padding="10,8">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{Binding MainText}"
                                                                       Foreground="#132235"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding SecondaryText}"
                                                                       Foreground="#5F7187"
                                                                       FontSize="12" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </StackPanel>

                                <Grid ColumnDefinitions="Auto,Auto"
                                      ColumnSpacing="14">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Gidiş tarihi"
                                                   Foreground="#243446"
                                                   FontWeight="SemiBold" />
                                        <Grid HorizontalAlignment="Left">
                                            <Border x:Name="FlightDepartureDateBox"
                                                    Width="142"
                                                    Height="38"
                                                    HorizontalAlignment="Left"
                                                    Background="White"
                                                    BorderBrush="#D6DFEA"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    PointerPressed="FlightDepartureDateBox_PointerPressed">
                                                <TextBlock x:Name="FlightDepartureDateTextBlock"
                                                           VerticalAlignment="Center"
                                                           Margin="12,0"
                                                           Foreground="#132235"
                                                           FontSize="16" />
                                            </Border>
                                            <CalendarDatePicker x:Name="FlightDepartureDatePicker"
                                                                Classes="search-picker"
                                                                Width="1"
                                                                HorizontalAlignment="Left"
                                                                Height="1"
                                                                Opacity="0"
                                                                SelectedDateChanged="FlightDatePicker_SelectedDateChanged" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel x:Name="FlightReturnDateContainer"
                                                Grid.Column="1"
                                                Spacing="6"
                                                IsVisible="False">
                                        <TextBlock Text="Dönüş tarihi"
                                                   Foreground="#243446"
                                                   FontWeight="SemiBold" />
                                        <Grid HorizontalAlignment="Left">
                                            <Border x:Name="FlightReturnDateBox"
                                                    Width="142"
                                                    Height="38"
                                                    HorizontalAlignment="Left"
                                                    Background="White"
                                                    BorderBrush="#D6DFEA"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    PointerPressed="FlightReturnDateBox_PointerPressed">
                                                <TextBlock x:Name="FlightReturnDateTextBlock"
                                                           VerticalAlignment="Center"
                                                           Margin="12,0"
                                                           Foreground="#132235"
                                                           FontSize="16" />
                                            </Border>
                                            <CalendarDatePicker x:Name="FlightReturnDatePicker"
                                                                Classes="search-picker"
                                                                Width="1"
                                                                HorizontalAlignment="Left"
                                                                Height="1"
                                                                Opacity="0"
                                                                SelectedDateChanged="FlightDatePicker_SelectedDateChanged" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal"
                                            Spacing="16">
                                    <CheckBox x:Name="FlightRoundTripCheckBox"
                                              Content="Gidiş-Dönüş"
                                              IsCheckedChanged="FlightRoundTripCheckBox_IsCheckedChanged" />
                                    <CheckBox x:Name="FlightOnlyNonStopCheckBox"
                                              Content="Sadece aktarmasız uçuşlar"
                                              IsCheckedChanged="FlightOnlyNonStopCheckBox_IsCheckedChanged" />
                                </StackPanel>

                                <Button x:Name="FlightSearchButton"
                                        Classes="primary"
                                        Content="Uçuş Ara"
                                        Click="FlightSearchButton_Click"
                                        Width="160" />
                            </StackPanel>

                                <Border Grid.Column="1"
                                    Background="White"
                                    BorderBrush="#D9E2EC"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="22">
                                 <Grid RowDefinitions="Auto,*,Auto"
                                       RowSpacing="16">
                                     <StackPanel Spacing="4">
                                         <TextBlock Text="Uçuş Sonuçları"
                                                    FontSize="20"
                                                    FontWeight="Bold"
                                                    Foreground="#122033" />
                                     </StackPanel>

                                     <Border Grid.Row="1"
                                             Background="#FBFDFF"
                                             BorderBrush="#E2EAF2"
                                             BorderThickness="1"
                                             CornerRadius="10"
                                             Padding="0">
                                         <Grid>
                                             <DataGrid x:Name="FlightResultsDataGrid"
                                                       AutoGenerateColumns="False"
                                                       IsReadOnly="True"
                                                       CanUserResizeColumns="True"
                                                       CanUserSortColumns="True"
                                                       SelectionMode="Single"
                                                       SelectionChanged="FlightResultsDataGrid_SelectionChanged"
                                                       HorizontalScrollBarVisibility="Auto"
                                                       VerticalScrollBarVisibility="Auto"
                                                       VerticalAlignment="Stretch"
                                                       HorizontalAlignment="Stretch"
                                                       MinHeight="440" />
                                             <TextBlock x:Name="FlightResultsEmptyTextBlock"
                                                        Text="Uçuş sonuçlarını görmek için arama yapın."
                                                        IsVisible="True"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        TextAlignment="Center"
                                                        TextWrapping="Wrap"
                                                        Foreground="#5F7187"
                                                        FontWeight="SemiBold" />
                                         </Grid>
                                     </Border>

                                     <!-- UÇUŞ İŞLEMLERİ TOOLBAR -->
                                     <StackPanel Grid.Row="2"
                                                 Orientation="Horizontal"
                                                 Spacing="10">
                                         <Button x:Name="FlightCreatePaymentButton"
                                                 Classes="primary btn-sm"
                                                 Content="Seçilen Uçuş İçin Ödeme"
                                                 IsEnabled="False"
                                                 Click="FlightCreatePaymentButton_Click" />
                                     </StackPanel>
                                 </Grid>
                             </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Grid.RowSpan="2"
                            x:Name="BrowserSectionPanel"
                            IsVisible="False"
                            Background="White"
                            BorderBrush="#D9E2EC"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="22">
                        <Grid RowDefinitions="Auto,*"
                              RowSpacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Tarayıcı Görünümü"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#122033" />
                            </StackPanel>

                            <Border Grid.Row="1"
                                    Background="#FBFDFF"
                                    BorderBrush="#E2EAF2"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="0"
                                    MinHeight="520">
                                <NativeWebView x:Name="EmbeddedBrowser"
                                               Source="about:blank" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Grid.RowSpan="2"
                            x:Name="HistoryPanel"
                            IsVisible="False"
                            Background="White"
                            BorderBrush="#D9E2EC"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="22">
                        <Grid x:Name="HistoryExportRoot">

                            <!-- KOLEKSİYONLAR LİSTESİ GÖRÜNÜMÜ -->
                            <Grid x:Name="CollectionsViewPanel"
                                  IsVisible="True"
                                  RowDefinitions="Auto,Auto,Auto,*"
                                  RowSpacing="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Geçmiş Kayıtlar ve Koleksiyonlar"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="#122033" />
                                </StackPanel>

                                <TextBlock x:Name="HistoryStatusTextBlock"
                                           Grid.Row="1"
                                           Foreground="#132235"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />

                                <!-- MODERN TOOLBAR -->
                                <Grid Grid.Row="2"
                                      ColumnDefinitions="Auto,*,Auto"
                                      VerticalAlignment="Center">
                                    <!-- SOL GRUP: ANA İŞLEMLER -->
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8">
                                        <Button x:Name="ViewVehiclesButton"
                                                Classes="primary btn-sm"
                                                Content="Araçları Göster"
                                                Click="ViewVehiclesButton_Click" />
                                        <!-- Extra - Dynamic Collections START -->
                                        <Button x:Name="RefreshCollectionButton"
                                                Classes="btn-secondary btn-sm"
                                                Content="Güncelle"
                                                Click="RefreshSelectedCollectionButton_Click" />
                                        <!-- Extra - Dynamic Collections END -->
                                        <Button x:Name="DeleteCollectionButton"
                                                Classes="btn-danger-subtle btn-sm"
                                                Content="Sil"
                                                Click="DeleteCollectionButton_Click" />
                                    </StackPanel>

                                    <!-- SAĞ GRUP: DIŞA AKTAR -->
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Dışa Aktar:"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#64748B"
                                                   Margin="0,0,4,0" />
                                        <Button x:Name="ExportPngButton"
                                                Classes="btn-secondary btn-sm"
                                                Content="PNG"
                                                Click="ExportPngButton_Click" />
                                        <!-- Extra - Collection Export START -->
                                        <Button x:Name="ExportCsvButton"
                                                Classes="btn-secondary btn-sm"
                                                Content="CSV"
                                                Click="ExportCsvButton_Click" />
                                        <Button x:Name="ExportExcelButton"
                                                Classes="btn-secondary btn-sm"
                                                Content="Excel"
                                                Click="ExportExcelButton_Click" />
                                        <!-- Extra - Collection Export END -->
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="3"
                                        Background="#FBFDFF"
                                        BorderBrush="#E2EAF2"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="0">
                                    <DataGrid x:Name="CollectionsDataGrid"
                                              AutoGenerateColumns="True"
                                              IsReadOnly="True"
                                              CanUserResizeColumns="True"
                                              CanUserSortColumns="True"
                                              SelectionMode="Extended"
                                              SelectionChanged="CollectionsDataGrid_SelectionChanged"
                                              DoubleTapped="CollectionsDataGrid_DoubleTapped"
                                              MinHeight="440" />
                                </Border>
                            </Grid>

                            <!-- KOLEKSİYON ARAÇLARI LİSTESİ GÖRÜNÜMÜ -->
                            <Grid x:Name="VehiclesViewPanel"
                                  IsVisible="False"
                                  RowDefinitions="Auto,Auto,Auto,*,Auto"
                                  RowSpacing="14">
                                <Grid ColumnDefinitions="*,Auto"
                                      VerticalAlignment="Center">
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="VehicleViewTitleTextBlock"
                                                   Text="Koleksiyondaki Araçlar"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="#122033" />
                                        <TextBlock x:Name="VehicleViewSubtitleTextBlock"
                                                   Text=""
                                                   IsVisible="False" />
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            x:Name="BackToCollectionsButton"
                                            Classes="btn-secondary btn-sm"
                                            Content="← Koleksiyonlara Dön"
                                            Click="BackToCollectionsButton_Click" />
                                </Grid>

                                <TextBlock x:Name="VehicleStatusTextBlock"
                                           Grid.Row="1"
                                           Foreground="#132235"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />

                                <!-- ARAÇLAR TOOLBAR -->
                                <Grid Grid.Row="2"
                                      ColumnDefinitions="Auto,*,Auto"
                                      VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8">
                                        <Button x:Name="CreatePaymentButton"
                                                Classes="primary btn-sm"
                                                Content="Seçilen Araç İçin Ödeme"
                                                Click="CreatePaymentButton_Click" />
                                        <!-- Extra - Dynamic Collections START -->
                                        <Button x:Name="RefreshCollectionButtonVehicles"
                                                Classes="btn-secondary btn-sm"
                                                Content="Güncelle"
                                                Click="RefreshSelectedCollectionButton_Click" />
                                        <!-- Extra - Dynamic Collections END -->
                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Dışa Aktar:"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#64748B"
                                                   Margin="0,0,4,0" />
                                        <Button x:Name="ExportPngButtonVehicles"
                                                Classes="btn-secondary btn-sm"
                                                Content="PNG"
                                                Click="ExportPngButton_Click" />
                                        <!-- Extra - Collection Export START -->
                                        <Button x:Name="ExportCsvButtonVehicles"
                                                Classes="btn-secondary btn-sm"
                                                Content="CSV"
                                                Click="ExportCsvButton_Click" />
                                        <Button x:Name="ExportExcelButtonVehicles"
                                                Classes="btn-secondary btn-sm"
                                                Content="Excel"
                                                Click="ExportExcelButton_Click" />
                                        <!-- Extra - Collection Export END -->
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="3"
                                        Background="#FBFDFF"
                                        BorderBrush="#E2EAF2"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="0">
                                    <DataGrid x:Name="CollectionVehiclesDataGrid"
                                              x:DataType="models:SearchResultItem"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserResizeColumns="True"
                                              CanUserSortColumns="True"
                                              SelectionMode="Single"
                                              SelectionChanged="CollectionVehiclesDataGrid_SelectionChanged"
                                              Height="420">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Araç" Binding="{Binding Title}" Width="2*" />
                                            <DataGridTextColumn Header="Fiyat" Binding="{Binding Price}" Width="1*" />
                                            <DataGridTextColumn Header="Günlük Fiyat" Binding="{Binding DailyPrice}" Width="1*" />
                                            <DataGridTextColumn Header="Vites" Binding="{Binding Transmission}" Width="1*" />
                                            <DataGridTextColumn Header="Yakıt" Binding="{Binding FuelType}" Width="1*" />
                                            <DataGridTextColumn Header="Tedarikçi" Binding="{Binding Supplier}" Width="1*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>

                                <StackPanel Grid.Row="4"
                                            Orientation="Horizontal"
                                            Spacing="10">
                                    <Button x:Name="BackToCollectionsButtonBottom"
                                            Classes="btn-secondary btn-sm"
                                            Content="← Koleksiyonlara Dön"
                                            Click="BackToCollectionsButton_Click" />
                                </StackPanel>
                            </Grid>

                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Grid.RowSpan="2"
                            x:Name="PaymentsPanel"
                            IsVisible="False"
                            Background="White"
                            BorderBrush="#D9E2EC"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="22">
                        <Grid RowDefinitions="Auto,Auto,*"
                              RowSpacing="16">
                            <Grid ColumnDefinitions="*,Auto"
                                  VerticalAlignment="Center">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Ödemeler"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="#122033" />
                                </StackPanel>

                                <!-- FİLTRELEME BUTONLARI -->
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Filtrele:"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#64748B"
                                               Margin="0,0,4,0" />
                                    <Button x:Name="PaymentFilterAllButton"
                                            Classes="primary btn-sm"
                                            Content="Tümü"
                                            Click="PaymentFilterAllButton_Click" />
                                    <Button x:Name="PaymentFilterCarButton"
                                            Classes="btn-secondary btn-sm"
                                            Content="Araç Kiralama"
                                            Click="PaymentFilterCarButton_Click" />
                                    <Button x:Name="PaymentFilterFlightButton"
                                            Classes="btn-secondary btn-sm"
                                            Content="Uçak Bileti"
                                            Click="PaymentFilterFlightButton_Click" />
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="PaymentsStatusTextBlock"
                                       Grid.Row="1"
                                       Foreground="#132235"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />

                            <Border Grid.Row="2"
                                    Background="#FBFDFF"
                                    BorderBrush="#E2EAF2"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="0">
                                <DataGrid x:Name="PaymentsDataGrid"
                                          AutoGenerateColumns="True"
                                          IsReadOnly="True"
                                          CanUserResizeColumns="True"
                                          CanUserSortColumns="True"
                                          Height="440" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Extra - Statistics START -->
                    <Border Grid.Row="1"
                            Grid.RowSpan="2"
                            x:Name="StatisticsPanel"
                            IsVisible="False"
                            Background="White"
                            BorderBrush="#D9E2EC"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="22">
                        <Grid RowDefinitions="Auto,*"
                              RowSpacing="18">
                            <StackPanel Spacing="4">
                                <TextBlock Text="İstatistikler"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#122033" />
                            </StackPanel>

                            <Grid Grid.Row="1"
                                  ColumnDefinitions="*,*,*,*"
                                  ColumnSpacing="14">
                                <Border Background="#F3F7FF" CornerRadius="10" Padding="18">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Koleksiyon" Foreground="#5F7187" />
                                        <TextBlock x:Name="StatisticsCollectionsTextBlock" FontSize="26" FontWeight="Bold" Foreground="#122033" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="#ECFDF5" CornerRadius="10" Padding="18">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Kayıtlı araç" Foreground="#39705A" />
                                        <TextBlock x:Name="StatisticsVehiclesTextBlock" FontSize="26" FontWeight="Bold" Foreground="#166534" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="#FFF7ED" CornerRadius="10" Padding="18">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Kiralama sayısı" Foreground="#8A5A24" />
                                        <TextBlock x:Name="StatisticsPaymentsTextBlock" FontSize="26" FontWeight="Bold" Foreground="#9A3412" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Background="#F5F3FF" CornerRadius="10" Padding="18">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Ödenen toplam" Foreground="#62548A" />
                                        <TextBlock x:Name="StatisticsTotalPaymentTextBlock" FontSize="26" FontWeight="Bold" Foreground="#4C1D95" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="1"
                                  ColumnDefinitions="*,*"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="14"
                                  RowSpacing="14">
                                <Border Background="#FBFDFF"
                                        BorderBrush="#E2EAF2"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12">
                                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                        <TextBlock Text="En çok kiralanan araçlar"
                                                   FontSize="17"
                                                   FontWeight="Bold"
                                                   Foreground="#122033" />
                                        <DataGrid Grid.Row="1"
                                                  x:Name="StatisticsVehiclesDataGrid"
                                                  IsReadOnly="True"
                                                  CanUserResizeColumns="True"
                                                  MinHeight="190" />
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1"
                                        Background="#FBFDFF"
                                        BorderBrush="#E2EAF2"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12">
                                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                        <TextBlock Text="En çok kullanılan şehirler"
                                                   FontSize="17"
                                                   FontWeight="Bold"
                                                   Foreground="#122033" />
                                        <DataGrid Grid.Row="1"
                                                  x:Name="StatisticsCitiesDataGrid"
                                                  IsReadOnly="True"
                                                  CanUserResizeColumns="True"
                                                  MinHeight="190" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1"
                                        Background="#FBFDFF"
                                        BorderBrush="#E2EAF2"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="En yüksek kiralama"
                                                   FontSize="17"
                                                   FontWeight="Bold"
                                                   Foreground="#122033" />
                                        <TextBlock x:Name="StatisticsHighestPaymentTextBlock"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   Foreground="#122033" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1"
                                        Grid.Column="1"
                                        Background="#FBFDFF"
                                        BorderBrush="#E2EAF2"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="En düşük kiralama"
                                                   FontSize="17"
                                                   FontWeight="Bold"
                                                   Foreground="#122033" />
                                        <TextBlock x:Name="StatisticsLowestPaymentTextBlock"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   Foreground="#122033" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                    <!-- Extra - Statistics END -->

                    <Border Grid.Row="1"
                            Grid.RowSpan="2"
                            x:Name="PaymentCheckoutPanel"
                            IsVisible="False"
                            Background="White"
                            BorderBrush="#D9E2EC"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="0">
                        <Grid Background="#F3F6FB"
                              ColumnDefinitions="1.15*,0.95*">
                            <Border Background="#115DF5"
                                    Padding="30"
                                    CornerRadius="10,0,0,10">
                                <Grid RowDefinitions="Auto,Auto,*,Auto"
                                      RowSpacing="18">
                                    <StackPanel Spacing="8">
                                        <Border Background="#2C74FF"
                                                CornerRadius="999"
                                                Padding="14,6"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="Ödeme"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Foreground="White" />
                                        </Border>
                                        <TextBlock Text="Güvenli Ödeme"
                                                   FontSize="30"
                                                   FontWeight="Bold"
                                                   Foreground="White" />
                                    </StackPanel>

                                    <Border Grid.Row="1"
                                            Background="#FFFFFF"
                                            CornerRadius="14"
                                            Padding="18">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Sepet Özeti"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Foreground="#122033" />
                                            <TextBlock x:Name="PaymentSummaryCollectionsTextBlock"
                                                       Text="-"
                                                       Foreground="#35516B"
                                                       TextWrapping="Wrap" />
                                            <Border Background="#F3F7FF"
                                                    CornerRadius="10"
                                                    Padding="12">
                                                <Grid ColumnDefinitions="*,Auto"
                                                      RowDefinitions="Auto,Auto"
                                                      RowSpacing="8">
                                                    <TextBlock Text="Seçilen kayıt"
                                                               Foreground="#48627A" />
                                                    <TextBlock x:Name="PaymentSummaryCountTextBlock"
                                                               Grid.Column="1"
                                                               Text="-"
                                                               Foreground="#122033"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Grid.Row="1"
                                                               Text="Toplam"
                                                               Foreground="#48627A"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock x:Name="PaymentSummaryTotalTextBlock"
                                                               Grid.Row="1"
                                                               Grid.Column="1"
                                                               Text="-"
                                                               FontSize="24"
                                                               FontWeight="Bold"
                                                               Foreground="#115DF5" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock x:Name="CheckoutStatusTextBlock"
                                               Grid.Row="3"
                                               Text=""
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="1"
                                    Background="#FBFCFE"
                                    Padding="30"
                                    CornerRadius="0,10,10,0">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*"
                                      RowSpacing="16">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Ödeme Bilgileri"
                                                   FontSize="24"
                                                   FontWeight="Bold"
                                                   Foreground="#122033" />
                                    </StackPanel>

                                    <Border Grid.Row="1"
                                            Background="White"
                                            BorderBrush="#D8E2EE"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="14">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Kart Üzerindeki Ad Soyad"
                                                       Foreground="#243446"
                                                       FontWeight="SemiBold" />
                                            <TextBox x:Name="PaymentCardHolderTextBox"
                                                     PlaceholderText="ERAY OZ" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="2"
                                            Background="White"
                                            BorderBrush="#D8E2EE"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="14">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Kart Numarası"
                                                       Foreground="#243446"
                                                       FontWeight="SemiBold" />
                                            <TextBox x:Name="PaymentCardNumberTextBox"
                                                     PlaceholderText="5526 0800 0000 0006" />
                                        </StackPanel>
                                    </Border>

                                    <Grid Grid.Row="3"
                                          ColumnDefinitions="*,*"
                                          ColumnSpacing="14">
                                        <Border Background="White"
                                                BorderBrush="#D8E2EE"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="14">
                                            <StackPanel Spacing="12">
                                                <TextBlock Text="Son Kullanma"
                                                           Foreground="#243446"
                                                           FontWeight="SemiBold" />
                                                <Grid ColumnDefinitions="*,Auto,*"
                                                      ColumnSpacing="10">
                                                    <TextBox x:Name="PaymentExpiryMonthTextBox"
                                                             PlaceholderText="12" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="/"
                                                               VerticalAlignment="Center"
                                                               FontSize="18"
                                                               Foreground="#61758A" />
                                                    <TextBox x:Name="PaymentExpiryYearTextBox"
                                                             Grid.Column="2"
                                                             PlaceholderText="28" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1"
                                                Background="White"
                                                BorderBrush="#D8E2EE"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="14">
                                            <StackPanel Spacing="12">
                                                <TextBlock Text="CVC"
                                                           Foreground="#243446"
                                                           FontWeight="SemiBold" />
                                                <TextBox x:Name="PaymentCvvTextBox"
                                                         PlaceholderText="123" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Row="4"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Stretch"
                                                Spacing="12">
                                        <Button x:Name="BackFromCheckoutButton"
                                                Content="Geri"
                                                Width="120"
                                                Click="BackFromCheckoutButton_Click" />
                                        <Button x:Name="ConfirmPaymentButton"
                                                Classes="primary"
                                                Content="Ödemeyi Başlat"
                                                Width="210"
                                                Click="ConfirmPaymentButton_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- Extra - Flight Car Recommendation START -->
                    <Border Grid.Row="1"
                            Grid.RowSpan="2"
                            x:Name="FlightCarRecommendationPanel"
                            IsVisible="False"
                            Background="White"
                            BorderBrush="#D9E2EC"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="32"
                            MaxWidth="760"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Grid>
                            <!-- ÖNERİ İÇERİK PANELİ -->
                            <StackPanel x:Name="FlightCarRecContentPanel"
                                        IsVisible="True"
                                        Spacing="24">
                                <!-- BAŞARI İKONU & BAŞLIK -->
                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                    <Border Background="#ECFDF5"
                                            BorderBrush="#A7F3D0"
                                            BorderThickness="1"
                                            CornerRadius="24"
                                            Padding="14,6"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="✓ Uçak Bileti Ödemesi Başarılı"
                                                   Foreground="#047857"
                                                   FontSize="13"
                                                   FontWeight="Bold" />
                                    </Border>

                                    <TextBlock Text="Biletiniz Başarıyla Alındı!"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#122033"
                                               HorizontalAlignment="Center" />

                                    <TextBlock Text="Seyahatiniz için iniş noktanızda konforlu bir kiralık araç bulmak ister misiniz?"
                                               FontSize="14"
                                               Foreground="#5F7187"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center" />
                                </StackPanel>

                                <!-- SEYAHAT BİLGİ KARTI -->
                                <Border Background="#F8FAFC"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="20">
                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Varış &amp; Araç Alış Yeri"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#64748B" />
                                            <TextBlock x:Name="FlightCarRecLocationTextBlock"
                                                       Text="-"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="#0F172A" />
                                        </StackPanel>

                                        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="20">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Araç Alış Tarihi &amp; Saati"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="#64748B" />
                                                <TextBlock x:Name="FlightCarRecPickupTextBlock"
                                                           Text="-"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1E293B" />
                                                <TextBlock Text="(İnişten 30 dk sonra teslim)"
                                                           FontSize="11"
                                                           Foreground="#94A3B8" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="Araç Bırakış Tarihi &amp; Saati"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="#64748B" />
                                                <TextBlock x:Name="FlightCarRecReturnTextBlock"
                                                           Text="-"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1E293B" />
                                                <TextBlock x:Name="FlightCarRecReturnSubtitleTextBlock"
                                                           Text="(Dönüşten önce teslim)"
                                                           FontSize="11"
                                                           Foreground="#94A3B8" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel x:Name="FlightCarRecDurationSelectorPanel"
                                                    Grid.Row="2"
                                                    IsVisible="False"
                                                    Spacing="10"
                                                    Margin="0,6,0,0">
                                            <TextBlock Text="Araç Teslim / Bırakış Tarihi:"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#64748B" />
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" VerticalAlignment="Center">
                                                <DatePicker x:Name="FlightCarRecReturnDatePicker"
                                                            SelectedDateChanged="FlightCarRecReturnDatePicker_SelectedDateChanged" />
                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            Spacing="6"
                                                            VerticalAlignment="Center">
                                                    <Button x:Name="FlightCarDuration1DayButton"
                                                            Classes="btn-secondary btn-sm"
                                                            Content="+1 Gün"
                                                            Click="FlightCarDurationButton_Click"
                                                            Tag="1" />
                                                    <Button x:Name="FlightCarDuration2DaysButton"
                                                            Classes="btn-secondary btn-sm"
                                                            Content="+2 Gün"
                                                            Click="FlightCarDurationButton_Click"
                                                            Tag="2" />
                                                    <Button x:Name="FlightCarDuration3DaysButton"
                                                            Classes="primary btn-sm"
                                                            Content="+3 Gün"
                                                            Click="FlightCarDurationButton_Click"
                                                            Tag="3" />
                                                    <Button x:Name="FlightCarDuration5DaysButton"
                                                            Classes="btn-secondary btn-sm"
                                                            Content="+5 Gün"
                                                            Click="FlightCarDurationButton_Click"
                                                            Tag="5" />
                                                    <Button x:Name="FlightCarDuration7DaysButton"
                                                            Classes="btn-secondary btn-sm"
                                                            Content="+7 Gün"
                                                            Click="FlightCarDurationButton_Click"
                                                            Tag="7" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- AKSİYON BUTONLARI -->
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Spacing="14">
                                    <Button x:Name="AcceptFlightCarRecommendationButton"
                                            Classes="primary btn-sm"
                                            Content="Evet, Uygun Araçları Bul"
                                            Click="AcceptFlightCarRecommendationButton_Click" />
                                    <Button x:Name="DeclineFlightCarRecommendationButton"
                                            Classes="btn-secondary btn-sm"
                                            Content="Hayır"
                                            Click="DeclineFlightCarRecommendationButton_Click" />
                                </StackPanel>
                            </StackPanel>

                            <!-- YÜKLENİYOR / ARAMA PANELİ -->
                            <StackPanel x:Name="FlightCarRecLoadingPanel"
                                        IsVisible="False"
                                        Spacing="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="0,20">
                                <Border Background="#EFF6FF"
                                        BorderBrush="#BFDBFE"
                                        BorderThickness="1"
                                        CornerRadius="50"
                                        Width="64"
                                        Height="64"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="🚗"
                                               FontSize="28"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <TextBlock Text="En Uygun Araçlar Bulunuyor..."
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="#122033"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="FlightCarRecLoadingStatusTextBlock"
                                               Text="Uçuş lokasyonunuz için kiralık araçlar taranıyor ve koleksiyonunuz hazırlanıyor..."
                                               FontSize="14"
                                               Foreground="#5F7187"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxWidth="480" />
                                </StackPanel>

                                <ProgressBar IsIndeterminate="True"
                                             Width="300"
                                             Height="6"
                                             CornerRadius="3"
                                             Foreground="#0F62FE"
                                             HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- Extra - Flight Car Recommendation END -->
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
