<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:Yolcu360Otomasyon.Models"
        mc:Ignorable="d"
        d:DesignWidth="1360"
        d:DesignHeight="860"
        x:Class="Yolcu360Otomasyon.MainWindow"
        Title="Yolcu360 Otomasyon"
        Width="1360"
        Height="860"
        Background="#F4F7FB">
    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="CaretBrush" Value="#132235" />
            <Setter Property="BorderBrush" Value="#D6DFEA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="TextBox:focus">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="BorderBrush" Value="#0F62FE" />
        </Style>

        <Style Selector="TextBox:pointerover">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#132235" />
        </Style>

        <Style Selector="TextBox /template/ ScrollViewer">
            <Setter Property="Background" Value="White" />
        </Style>

        <Style Selector="TextBox /template/ Border">
            <Setter Property="Background" Value="White" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="BorderBrush" Value="#D6DFEA" />
        </Style>

        <Style Selector="ComboBox:focus">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="BorderBrush" Value="#0F62FE" />
        </Style>

        <Style Selector="CalendarDatePicker.search-picker">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="0,7" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>

        <Style Selector="CalendarDatePicker.search-picker:focus">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="CalendarDatePicker.search-picker:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="CalendarDatePicker.search-picker TextBlock">
            <Setter Property="Foreground" Value="#132235" />
        </Style>

        <Style Selector="CalendarDatePicker.search-picker /template/ Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>

        <Style Selector="CalendarDatePicker.search-picker /template/ Button:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="CalendarDatePicker.search-picker /template/ Button:pressed">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="Calendar">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#132235" />
        </Style>

        <Style Selector="Calendar /template/ Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D6DFEA" />
        </Style>

        <Style Selector="CalendarDayButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="CalendarDayButton:pointerover">
            <Setter Property="Background" Value="#EEF4FF" />
            <Setter Property="Foreground" Value="#0F62FE" />
            <Setter Property="BorderBrush" Value="#CFE0FF" />
        </Style>

        <Style Selector="CalendarDayButton:selected">
            <Setter Property="Background" Value="#0F62FE" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#0F62FE" />
        </Style>

        <Style Selector="CalendarDayButton:disabled">
            <Setter Property="Foreground" Value="#A4B1C0" />
        </Style>

        <Style Selector="CalendarButton">
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="CalendarButton:pointerover">
            <Setter Property="Background" Value="#EEF4FF" />
            <Setter Property="Foreground" Value="#0F62FE" />
        </Style>

        <Style Selector="DatePickerPresenter">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D6DFEA" />
        </Style>

        <Style Selector="ComboBox.search-picker">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="BorderBrush" Value="#D6DFEA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style Selector="ComboBox.search-picker:focus">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="BorderBrush" Value="#0F62FE" />
        </Style>

        <Style Selector="ComboBox.search-picker TextBlock">
            <Setter Property="Foreground" Value="#132235" />
        </Style>

        <Style Selector="PopupRoot">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#0F62FE" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#0F62FE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#0B57E3" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#0B57E3" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.primary:pressed">
            <Setter Property="Background" Value="#0847BC" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#0847BC" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.primary:disabled">
            <Setter Property="Background" Value="#9DBCFB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#9DBCFB" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.primary /template/ ContentPresenter">
            <Setter Property="TextElement.Foreground" Value="White" />
        </Style>

        <Style Selector="Button.primary /template/ Border">
            <Setter Property="Background" Value="#0F62FE" />
            <Setter Property="BorderBrush" Value="#0F62FE" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.primary:pointerover /template/ Border">
            <Setter Property="Background" Value="#0B57E3" />
            <Setter Property="BorderBrush" Value="#0B57E3" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.primary:pressed /template/ Border">
            <Setter Property="Background" Value="#0847BC" />
            <Setter Property="BorderBrush" Value="#0847BC" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="BorderBrush" Value="#D6DFEA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowHeight" Value="46" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
        </Style>

        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF3F9" />
            <Setter Property="Foreground" Value="#233143" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,10" />
        </Style>

        <Style Selector="DataGridRow">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#132235" />
        </Style>

        <Style Selector="DataGridRow:pointerover">
            <Setter Property="Background" Value="#F8FBFF" />
            <Setter Property="Foreground" Value="#132235" />
        </Style>

        <Style Selector="DataGridCell">
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#E8EEF5" />
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <Style Selector="DataGridCell:current">
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="Background" Value="#EEF4FF" />
        </Style>

        <Style Selector="DataGridCell TextBlock">
            <Setter Property="Foreground" Value="#132235" />
        </Style>
    </Window.Styles>

    <Grid>
        <Border x:Name="LoginView"
                Margin="28"
                Background="White"
                BorderBrush="#D9E2EC"
                BorderThickness="1"
                CornerRadius="10"
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="460">
            <StackPanel Spacing="18">
                <StackPanel Spacing="6">
                    <TextBlock Text="Giriş Yap"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#122033" />
                    <TextBlock Text="Email ve şifrenizle giriş yapın. Kayıtlı telefon numarası ile Yolcu360 oturumu açılır."
                               Foreground="#5F7187"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Email"
                               Foreground="#243446"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="LoginEmailTextBox"
                             PlaceholderText="mail@example.com" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Şifre"
                               Foreground="#243446"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="LoginPasswordTextBox"
                             PlaceholderText="Uygulama şifresi" />
                </StackPanel>

                <Button x:Name="LoginButton"
                        Classes="primary"
                        Content="Giriş Yap"
                        Click="LoginButton_Click" />

                <Button x:Name="GoToRegisterButton"
                        Content="Kayıt Ol"
                        Click="GoToRegisterButton_Click" />

                <TextBlock x:Name="StatusTextBlock"
                           Text="Hazır"
                           TextWrapping="Wrap"
                           Foreground="#132235"
                           FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <Border x:Name="RegisterView"
                IsVisible="False"
                Margin="28"
                Background="White"
                BorderBrush="#D9E2EC"
                BorderThickness="1"
                CornerRadius="10"
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="460">
            <StackPanel Spacing="18">
                <StackPanel Spacing="6">
                    <TextBlock Text="Kayıt Ol"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#122033" />
                    <TextBlock Text="Email, şifre ve telefon numarasıyla hesabınızı oluşturun."
                               Foreground="#5F7187"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Email"
                               Foreground="#243446"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="RegisterEmailTextBox"
                             PlaceholderText="mail@example.com" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Şifre"
                               Foreground="#243446"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="RegisterPasswordTextBox"
                             PlaceholderText="Uygulama şifresi" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Telefon numarası"
                               Foreground="#243446"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="RegisterPhoneNumberTextBox"
                             PlaceholderText="5xxxxxxxxx" />
                </StackPanel>

                <Button x:Name="RegisterButton"
                        Classes="primary"
                        Content="Kaydol ve Giriş Yap"
                        Click="RegisterButton_Click" />

                <Button x:Name="BackToLoginButton"
                        Content="Giriş Sayfasına Dön"
                        Click="BackToLoginButton_Click" />

                <TextBlock x:Name="RegisterStatusTextBlock"
                           Text=""
                           TextWrapping="Wrap"
                           Foreground="#132235"
                           FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="MainView"
                      IsVisible="False"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid Margin="28"
                  RowDefinitions="Auto,*"
                  RowSpacing="20">
                <Border Background="#0F172A"
                        CornerRadius="10"
                        Padding="28">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="24">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Yolcu360 Operasyon Paneli"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="White" />

                            <TextBlock Text="Kayıtlı oturumla arama ve sonuç akışını yönetin."
                                       FontSize="15"
                                       Foreground="#C7D2E4" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                x:Name="LogoutButton"
                                Content="Çıkış Yap"
                                Width="120"
                                VerticalAlignment="Center"
                                Click="LogoutButton_Click" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1"
                      RowDefinitions="Auto,Auto,*"
                      RowSpacing="20">
                    <StackPanel x:Name="TopNavigationPanel"
                                Orientation="Horizontal"
                                Spacing="10">
                        <Button x:Name="SearchTabButton"
                                Classes="primary"
                                Content="Araç Kirala"
                                Width="160"
                                Click="SearchTabButton_Click" />
                        <Button x:Name="FlightTabButton"
                                Content="Uçak Bileti"
                                Width="160"
                                Click="FlightTabButton_Click" />
                        <Button x:Name="HistoryTabButton"
                                Content="Geçmiş Kayıtlar"
                                Width="180"
                                Click="HistoryTabButton_Click" />
                        <Button x:Name="PaymentsTabButton"
                                Content="Ödemeler"
                                Width="160"
                                Click="PaymentsTabButton_Click" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            x:Name="SearchPanel"
                            Background="White"
                            BorderBrush="#D9E2EC"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="22">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="26">
                        <StackPanel Grid.Column="0"
                                    Spacing="18">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Arama ve Filtreleme"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#122033" />
                                <TextBlock Text="Alış noktası, tarih ve araç filtreleriyle sonuçları listeleyin."
                                           Foreground="#5F7187" />
                            </StackPanel>

                            <TextBlock x:Name="SearchStatusTextBlock"
                                       Text=""
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="#132235"
                                       FontWeight="SemiBold" />

                            <StackPanel Spacing="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Alış yeri"
                                               Foreground="#243446"
                                               FontWeight="SemiBold" />
                                    <!-- Extra - Location Suggestion START -->
                                    <TextBox x:Name="PickupLocationTextBox"
                                             PlaceholderText="Düzce"
                                             Width="430"
                                             HorizontalAlignment="Left"
                                             TextChanged="PickupLocationTextBox_TextChanged" />
                                    <Border x:Name="PickupLocationSuggestionsPanel"
                                            IsVisible="False"
                                            Background="White"
                                            BorderBrush="#D6DFEA"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Margin="0,-2,0,0"
                                            Width="430"
                                            HorizontalAlignment="Left"
                                            MaxHeight="220">
                                        <ListBox x:Name="PickupLocationSuggestionsListBox"
                                                 Background="White"
                                                 SelectionChanged="PickupLocationSuggestionsListBox_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:LocationSuggestionItem">
                                                    <Border Padding="10,8">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{Binding MainText}"
                                                                       Foreground="#132235"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding SecondaryText}"
                                                                       Foreground="#5F7187"
                                                                       FontSize="12" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                    <!-- Extra - Location Suggestion END -->
                                </StackPanel>

                                <Grid ColumnDefinitions="Auto,Auto"
                                      ColumnSpacing="75"
                                      HorizontalAlignment="Left">
                                    <StackPanel Spacing="14">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Alış tarihi"
                                                       Foreground="#243446"
                                                       FontWeight="SemiBold" />
                                            <Grid>
                                            <Border x:Name="PickupDateBox"
                                                    Width="142"
                                                    Height="38"
                                                    Background="White"
                                                    BorderBrush="#D6DFEA"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    PointerPressed="PickupDateBox_PointerPressed">
                                                <TextBlock x:Name="PickupDateTextBlock"
                                                           VerticalAlignment="Center"
                                                           Margin="12,0"
                                                           Foreground="#132235"
                                                           FontSize="16" />
                                            </Border>
                                                <CalendarDatePicker x:Name="PickupDatePicker"
                                                                    Classes="search-picker"
                                                                    Width="1"
                                                                    HorizontalAlignment="Left"
                                                                    Height="1"
                                                                    Opacity="0"
                                                                    SelectedDateChanged="SearchDatePicker_SelectedDateChanged" />
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Alış saati"
                                                       Foreground="#243446"
                                                       FontWeight="SemiBold" />
                                            <ComboBox x:Name="PickupTimeComboBox"
                                                      Classes="search-picker"
                                                      Width="92"
                                                      HorizontalAlignment="Left"
                                                      Height="38" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Spacing="14">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Dönüş tarihi"
                                                       Foreground="#243446"
                                                       FontWeight="SemiBold" />
                                            <Grid>
                                            <Border x:Name="ReturnDateBox"
                                                    Width="142"
                                                    Height="38"
                                                    Background="White"
                                                    BorderBrush="#D6DFEA"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    PointerPressed="ReturnDateBox_PointerPressed">
                                                <TextBlock x:Name="ReturnDateTextBlock"
                                                           VerticalAlignment="Center"
                                                           Margin="12,0"
                                                           Foreground="#132235"
                                                           FontSize="16" />
                                            </Border>
                                                <CalendarDatePicker x:Name="ReturnDatePicker"
                                                                    Classes="search-picker"
                                                                    Width="1"
                                                                    HorizontalAlignment="Left"
                                                                    Height="1"
                                                                    Opacity="0"
                                                                    SelectedDateChanged="SearchDatePicker_SelectedDateChanged" />
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Dönüş saati"
                                                       Foreground="#243446"
                                                       FontWeight="SemiBold" />
                                            <ComboBox x:Name="ReturnTimeComboBox"
                                                      Classes="search-picker"
                                                      Width="92"
                                                      HorizontalAlignment="Left"
                                                      Height="38" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,Auto"
                                      ColumnSpacing="8"
                                      HorizontalAlignment="Left">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Vites"
                                                   Foreground="#243446"
                                                   FontWeight="SemiBold" />
                                        <ComboBox x:Name="TransmissionComboBox"
                                                  Width="180"
                                                  SelectedIndex="0">
                                            <ComboBoxItem Content="Farketmez" Tag="" />
                                            <ComboBoxItem Content="Otomatik" Tag="otomatik" />
                                            <ComboBoxItem Content="Manuel" Tag="manuel" />
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Spacing="6">
                                        <TextBlock Text="Yakıt"
                                                   Foreground="#243446"
                                                   FontWeight="SemiBold" />
                                        <ComboBox x:Name="FuelComboBox"
                                                  Width="180"
                                                  SelectedIndex="0">
                                            <ComboBoxItem Content="Farketmez" Tag="" />
                                            <ComboBoxItem Content="Dizel" Tag="dizel" />
                                            <ComboBoxItem Content="Benzin" Tag="benzin" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <Button x:Name="SearchButton"
                                    Classes="primary"
                                    Content="Ara"
                                    Click="SearchButton_Click"
                                    Width="160" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                x:Name="SearchResultsPanel"
                                IsVisible="False"
                                Background="White"
                                BorderBrush="#D9E2EC"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="18">
                            <Grid RowDefinitions="Auto,Auto,*"
                                  RowSpacing="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Arama Sonuçları"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="#122033" />
                                    <TextBlock Text="Liste doğrudan tarayıcıdan okunan sonuçlarla güncellenir."
                                               Foreground="#5F7187" />
                                </StackPanel>

                                <Grid Grid.Row="1"
                                      ColumnDefinitions="*,Auto"
                                      ColumnSpacing="10">
                                    <TextBox x:Name="CollectionNameTextBox"
                                             PlaceholderText="Kaydetmek için özel isim girin" />
                                    <Button Grid.Column="1"
                                            x:Name="SaveResultsButton"
                                            Classes="primary"
                                            Content="Kaydet"
                                            Width="120"
                                            Click="SaveResultsButton_Click" />
                                </Grid>

                                <Border Grid.Row="2"
                                        Background="#FBFDFF"
                                        BorderBrush="#E2EAF2"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="0">
                                    <DataGrid x:Name="ResultsDataGrid"
                                              AutoGenerateColumns="True"
                                              IsReadOnly="True"
                                              CanUserResizeColumns="True"
                                              CanUserSortColumns="True"
                                              VerticalAlignment="Stretch"
                                              HorizontalAlignment="Stretch"
                                              Height="420" />
                                </Border>
                            </Grid>
                        </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Grid.RowSpan="2"
                            x:Name="FlightPanel"
                            IsVisible="False"
                            Background="White"
                            BorderBrush="#D9E2EC"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="22">
                        <StackPanel Spacing="18">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Uçak Bileti Arama"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#122033" />
                                <TextBlock Text="Uçuş araması ayrı Flight akışıyla gömülü tarayıcıda çalıştırılır."
                                           Foreground="#5F7187" />
                            </StackPanel>

                            <TextBlock x:Name="FlightStatusTextBlock"
                                       Text=""
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="#132235"
                                       FontWeight="SemiBold" />

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Nereden?"
                                               Foreground="#243446"
                                               FontWeight="SemiBold" />
                                    <TextBox x:Name="FlightFromTextBox"
                                             PlaceholderText="İstanbul Havalimanı"
                                             TextChanged="FlightFromTextBox_TextChanged" />
                                    <Border x:Name="FlightFromSuggestionsPanel"
                                            IsVisible="False"
                                            Background="White"
                                            BorderBrush="#D6DFEA"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Margin="0,-2,0,0"
                                            MaxHeight="220">
                                        <ListBox x:Name="FlightFromSuggestionsListBox"
                                                 Background="White"
                                                 SelectionChanged="FlightFromSuggestionsListBox_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:LocationSuggestionItem">
                                                    <Border Padding="10,8">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{Binding MainText}"
                                                                       Foreground="#132235"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding SecondaryText}"
                                                                       Foreground="#5F7187"
                                                                       FontSize="12" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Spacing="6">
                                    <TextBlock Text="Nereye?"
                                               Foreground="#243446"
                                               FontWeight="SemiBold" />
                                    <TextBox x:Name="FlightToTextBox"
                                             PlaceholderText="Esenboğa Havalimanı"
                                             TextChanged="FlightToTextBox_TextChanged" />
                                    <Border x:Name="FlightToSuggestionsPanel"
                                            IsVisible="False"
                                            Background="White"
                                            BorderBrush="#D6DFEA"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Margin="0,-2,0,0"
                                            MaxHeight="220">
                                        <ListBox x:Name="FlightToSuggestionsListBox"
                                                 Background="White"
                                                 SelectionChanged="FlightToSuggestionsListBox_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:LocationSuggestionItem">
                                                    <Border Padding="10,8">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{Binding MainText}"
                                                                       Foreground="#132235"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding SecondaryText}"
                                                                       Foreground="#5F7187"
                                                                       FontSize="12" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Gidiş tarihi"
                                               Foreground="#243446"
                                               FontWeight="SemiBold" />
                                    <TextBox x:Name="FlightDepartureDateTextBox"
                                             PlaceholderText="2026-08-20" />
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Spacing="6">
                                    <TextBlock Text="Dönüş tarihi"
                                               Foreground="#243446"
                                               FontWeight="SemiBold" />
                                    <TextBox x:Name="FlightReturnDateTextBox"
                                             PlaceholderText="Tek yön için boş bırakın" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="16">
                                <CheckBox x:Name="FlightRoundTripCheckBox"
                                          Content="Gidiş-Dönüş" />
                                <CheckBox x:Name="FlightOnlyNonStopCheckBox"
                                          Content="Sadece aktarmasız uçuşlar" />
                            </StackPanel>

                            <Button x:Name="FlightSearchButton"
                                    Classes="primary"
                                    Content="Uçuş Ara"
                                    Click="FlightSearchButton_Click"
                                    Width="160" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Grid.RowSpan="2"
                            x:Name="BrowserSectionPanel"
                            IsVisible="False"
                            Background="White"
                            BorderBrush="#D9E2EC"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="22">
                        <Grid RowDefinitions="Auto,*"
                              RowSpacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Tarayıcı Görünümü"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#122033" />
                                <TextBlock Text="Arama işlemi sırasında gömülü tarayıcı ekranı burada görüntülenir."
                                           Foreground="#5F7187" />
                            </StackPanel>

                            <Border Grid.Row="1"
                                    Background="#FBFDFF"
                                    BorderBrush="#E2EAF2"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="0"
                                    MinHeight="520">
                                <NativeWebView x:Name="EmbeddedBrowser"
                                               Source="about:blank" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Grid.RowSpan="2"
                            x:Name="HistoryPanel"
                            IsVisible="False"
                            Background="White"
                            BorderBrush="#D9E2EC"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="22">
                        <Grid x:Name="HistoryExportRoot">

                            <!-- KOLEKSİYONLAR LİSTESİ GÖRÜNÜMÜ -->
                            <Grid x:Name="CollectionsViewPanel"
                                  IsVisible="True"
                                  RowDefinitions="Auto,Auto,*,Auto,Auto"
                                  RowSpacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Geçmiş Kayıtlar ve Koleksiyonlar"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="#122033" />
                                    <TextBlock Text="Kaydedilen arama listelerinizi inceleyin, araçlarını görüntüleyin veya PNG olarak indirin."
                                               Foreground="#5F7187" />
                                </StackPanel>

                                <TextBlock x:Name="HistoryStatusTextBlock"
                                           Grid.Row="1"
                                           Foreground="#132235"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />

                                <Border Grid.Row="2"
                                        Background="#FBFDFF"
                                        BorderBrush="#E2EAF2"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="0">
                                    <DataGrid x:Name="CollectionsDataGrid"
                                              AutoGenerateColumns="True"
                                              IsReadOnly="True"
                                              CanUserResizeColumns="True"
                                              CanUserSortColumns="True"
                                              SelectionMode="Extended"
                                              SelectionChanged="CollectionsDataGrid_SelectionChanged"
                                              DoubleTapped="CollectionsDataGrid_DoubleTapped"
                                              MinHeight="280" />
                                </Border>

                                <StackPanel Grid.Row="3"
                                            Orientation="Horizontal"
                                            Spacing="12">
                                    <Button x:Name="ViewVehiclesButton"
                                            Classes="primary"
                                            Content="Araçları Göster"
                                            Width="160"
                                            Click="ViewVehiclesButton_Click" />
                                    <!-- Extra - Dynamic Collections START -->
                                    <Button x:Name="RefreshCollectionButton"
                                            Content="Güncelle"
                                            Width="130"
                                            Click="RefreshSelectedCollectionButton_Click" />
                                    <!-- Extra - Dynamic Collections END -->
                                    <Button x:Name="DeleteCollectionButton"
                                            Content="Sil"
                                            Width="120"
                                            Click="DeleteCollectionButton_Click" />
                                    <Button x:Name="ExportPngButton"
                                            Classes="primary"
                                            Content="PNG Olarak İndir"
                                            Width="180"
                                            Click="ExportPngButton_Click" />
                                </StackPanel>

                                <Border Grid.Row="4"
                                        Background="#F7FAFE"
                                        BorderBrush="#DCE6F2"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="18">
                                    <Grid ColumnDefinitions="*,*"
                                          RowDefinitions="Auto,Auto,Auto"
                                          ColumnSpacing="18"
                                          RowSpacing="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Seçili Kayıt"
                                                       FontWeight="Bold"
                                                       Foreground="#122033" />
                                            <TextBlock x:Name="SelectedCollectionNameTextBlock"
                                                       Text="-"
                                                       Foreground="#132235"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Spacing="4">
                                            <TextBlock Text="Alış Yeri"
                                                       FontWeight="Bold"
                                                       Foreground="#122033" />
                                            <TextBlock x:Name="SelectedCollectionLocationTextBlock"
                                                       Text="-"
                                                       Foreground="#132235"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1"
                                                    Spacing="4">
                                            <TextBlock Text="Tarih ve Saat"
                                                       FontWeight="Bold"
                                                       Foreground="#122033" />
                                            <TextBlock x:Name="SelectedCollectionDateRangeTextBlock"
                                                       Text="-"
                                                       Foreground="#132235"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1"
                                                    Grid.Column="1"
                                                    Spacing="4">
                                            <TextBlock Text="Filtreler"
                                                       FontWeight="Bold"
                                                       Foreground="#122033" />
                                            <TextBlock x:Name="SelectedCollectionFiltersTextBlock"
                                                       Text="-"
                                                       Foreground="#132235"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="2"
                                                    Spacing="4">
                                            <TextBlock Text="Araç Sayısı"
                                                       FontWeight="Bold"
                                                       Foreground="#122033" />
                                            <TextBlock x:Name="SelectedCollectionCountTextBlock"
                                                       Text="-"
                                                       Foreground="#132235"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="2"
                                                    Grid.Column="1"
                                                    Spacing="4">
                                            <TextBlock Text="Oluşturulma"
                                                       FontWeight="Bold"
                                                       Foreground="#122033" />
                                            <TextBlock x:Name="SelectedCollectionCreatedAtTextBlock"
                                                       Text="-"
                                                       Foreground="#132235"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- KOLEKSİYON ARAÇLARI LİSTESİ GÖRÜNÜMÜ -->
                            <Grid x:Name="VehiclesViewPanel"
                                  IsVisible="False"
                                  RowDefinitions="Auto,Auto,*,Auto"
                                  RowSpacing="16">
                                <Grid ColumnDefinitions="*,Auto"
                                      VerticalAlignment="Center">
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="VehicleViewTitleTextBlock"
                                                   Text="Koleksiyondaki Araçlar"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   Foreground="#122033" />
                                        <TextBlock x:Name="VehicleViewSubtitleTextBlock"
                                                   Text="Aşağıdaki listeden bir araç seçerek ödemesini gerçekleştirebilirsiniz."
                                                   Foreground="#5F7187" />
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            x:Name="BackToCollectionsButton"
                                            Content="← Koleksiyonlara Dön"
                                            Width="190"
                                            Click="BackToCollectionsButton_Click" />
                                </Grid>

                                <TextBlock x:Name="VehicleStatusTextBlock"
                                           Grid.Row="1"
                                           Foreground="#132235"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />

                                <Border Grid.Row="2"
                                        Background="#FBFDFF"
                                        BorderBrush="#E2EAF2"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="0">
                                    <DataGrid x:Name="CollectionVehiclesDataGrid"
                                              x:DataType="models:SearchResultItem"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserResizeColumns="True"
                                              CanUserSortColumns="True"
                                              SelectionMode="Single"
                                              SelectionChanged="CollectionVehiclesDataGrid_SelectionChanged"
                                              MinHeight="300">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Araç" Binding="{Binding Title}" Width="2*" />
                                            <DataGridTextColumn Header="Detay" Binding="{Binding Subtitle}" Width="2*" />
                                            <DataGridTextColumn Header="Fiyat" Binding="{Binding Price}" Width="1*" />
                                            <DataGridTextColumn Header="Günlük Fiyat" Binding="{Binding DailyPrice}" Width="1*" />
                                            <DataGridTextColumn Header="Vites" Binding="{Binding Transmission}" Width="1*" />
                                            <DataGridTextColumn Header="Yakıt" Binding="{Binding FuelType}" Width="1*" />
                                            <DataGridTextColumn Header="Tedarikçi" Binding="{Binding Supplier}" Width="1*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>

                                <StackPanel Grid.Row="3"
                                            Orientation="Horizontal"
                                            Spacing="12">
                                    <Button x:Name="BackToCollectionsButtonBottom"
                                            Content="← Koleksiyonlara Dön"
                                            Width="190"
                                            Click="BackToCollectionsButton_Click" />
                                    <Button x:Name="CreatePaymentButton"
                                            Classes="primary"
                                            Content="Seçilen Araç İçin Ödeme"
                                            Width="220"
                                            Click="CreatePaymentButton_Click" />
                                    <!-- Extra - Dynamic Collections START -->
                                    <Button x:Name="RefreshCollectionButtonVehicles"
                                            Content="Güncelle"
                                            Width="130"
                                            Click="RefreshSelectedCollectionButton_Click" />
                                    <!-- Extra - Dynamic Collections END -->
                                    <Button x:Name="ExportPngButtonVehicles"
                                            Classes="primary"
                                            Content="PNG Olarak İndir"
                                            Width="180"
                                            Click="ExportPngButton_Click" />
                                </StackPanel>
                            </Grid>

                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Grid.RowSpan="2"
                            x:Name="PaymentsPanel"
                            IsVisible="False"
                            Background="White"
                            BorderBrush="#D9E2EC"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="22">
                        <Grid RowDefinitions="Auto,Auto,*"
                              RowSpacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Ödemeler"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#122033" />
                            </StackPanel>

                            <TextBlock x:Name="PaymentsStatusTextBlock"
                                       Grid.Row="1"
                                       Foreground="#132235"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />

                            <Border Grid.Row="2"
                                    Background="#FBFDFF"
                                    BorderBrush="#E2EAF2"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="0">
                                <DataGrid x:Name="PaymentsDataGrid"
                                          AutoGenerateColumns="True"
                                          IsReadOnly="True"
                                          CanUserResizeColumns="True"
                                          CanUserSortColumns="True"
                                          MinHeight="420" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Grid.RowSpan="2"
                            x:Name="PaymentCheckoutPanel"
                            IsVisible="False"
                            Background="White"
                            BorderBrush="#D9E2EC"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="0">
                        <Grid Background="#F3F6FB"
                              ColumnDefinitions="1.15*,0.95*">
                            <Border Background="#115DF5"
                                    Padding="30"
                                    CornerRadius="10,0,0,10">
                                <Grid RowDefinitions="Auto,Auto,*,Auto"
                                      RowSpacing="18">
                                    <StackPanel Spacing="8">
                                        <Border Background="#2C74FF"
                                                CornerRadius="999"
                                                Padding="14,6"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="Ödeme"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Foreground="White" />
                                        </Border>
                                        <TextBlock Text="Güvenli Ödeme"
                                                   FontSize="30"
                                                   FontWeight="Bold"
                                                   Foreground="White" />
                                    </StackPanel>

                                    <Border Grid.Row="1"
                                            Background="#FFFFFF"
                                            CornerRadius="14"
                                            Padding="18">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Sepet Özeti"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Foreground="#122033" />
                                            <TextBlock x:Name="PaymentSummaryCollectionsTextBlock"
                                                       Text="-"
                                                       Foreground="#35516B"
                                                       TextWrapping="Wrap" />
                                            <Border Background="#F3F7FF"
                                                    CornerRadius="10"
                                                    Padding="12">
                                                <Grid ColumnDefinitions="*,Auto"
                                                      RowDefinitions="Auto,Auto"
                                                      RowSpacing="8">
                                                    <TextBlock Text="Seçilen kayıt"
                                                               Foreground="#48627A" />
                                                    <TextBlock x:Name="PaymentSummaryCountTextBlock"
                                                               Grid.Column="1"
                                                               Text="-"
                                                               Foreground="#122033"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Grid.Row="1"
                                                               Text="Toplam"
                                                               Foreground="#48627A"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock x:Name="PaymentSummaryTotalTextBlock"
                                                               Grid.Row="1"
                                                               Grid.Column="1"
                                                               Text="-"
                                                               FontSize="24"
                                                               FontWeight="Bold"
                                                               Foreground="#115DF5" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock x:Name="CheckoutStatusTextBlock"
                                               Grid.Row="3"
                                               Text=""
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="1"
                                    Background="#FBFCFE"
                                    Padding="30"
                                    CornerRadius="0,10,10,0">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*"
                                      RowSpacing="16">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Ödeme Bilgileri"
                                                   FontSize="24"
                                                   FontWeight="Bold"
                                                   Foreground="#122033" />
                                    </StackPanel>

                                    <Border Grid.Row="1"
                                            Background="White"
                                            BorderBrush="#D8E2EE"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="14">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Kart Üzerindeki Ad Soyad"
                                                       Foreground="#243446"
                                                       FontWeight="SemiBold" />
                                            <TextBox x:Name="PaymentCardHolderTextBox"
                                                     PlaceholderText="ERAY OZ" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="2"
                                            Background="White"
                                            BorderBrush="#D8E2EE"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="14">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Kart Numarası"
                                                       Foreground="#243446"
                                                       FontWeight="SemiBold" />
                                            <TextBox x:Name="PaymentCardNumberTextBox"
                                                     PlaceholderText="5526 0800 0000 0006" />
                                        </StackPanel>
                                    </Border>

                                    <Grid Grid.Row="3"
                                          ColumnDefinitions="*,*"
                                          ColumnSpacing="14">
                                        <Border Background="White"
                                                BorderBrush="#D8E2EE"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="14">
                                            <StackPanel Spacing="12">
                                                <TextBlock Text="Son Kullanma"
                                                           Foreground="#243446"
                                                           FontWeight="SemiBold" />
                                                <Grid ColumnDefinitions="*,Auto,*"
                                                      ColumnSpacing="10">
                                                    <TextBox x:Name="PaymentExpiryMonthTextBox"
                                                             PlaceholderText="12" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="/"
                                                               VerticalAlignment="Center"
                                                               FontSize="18"
                                                               Foreground="#61758A" />
                                                    <TextBox x:Name="PaymentExpiryYearTextBox"
                                                             Grid.Column="2"
                                                             PlaceholderText="28" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1"
                                                Background="White"
                                                BorderBrush="#D8E2EE"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="14">
                                            <StackPanel Spacing="12">
                                                <TextBlock Text="CVC"
                                                           Foreground="#243446"
                                                           FontWeight="SemiBold" />
                                                <TextBox x:Name="PaymentCvvTextBox"
                                                         PlaceholderText="123" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Row="4"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Stretch"
                                                Spacing="12">
                                        <Button x:Name="BackFromCheckoutButton"
                                                Content="Geri"
                                                Width="120"
                                                Click="BackFromCheckoutButton_Click" />
                                        <Button x:Name="ConfirmPaymentButton"
                                                Classes="primary"
                                                Content="Ödemeyi Başlat"
                                                Width="210"
                                                Click="ConfirmPaymentButton_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
