<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1360"
        d:DesignHeight="860"
        x:Class="Yolcu360Otomasyon.MainWindow"
        Title="Yolcu360 Otomasyon"
        Width="1360"
        Height="860"
        Background="#F4F7FB">
    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="CaretBrush" Value="#132235" />
            <Setter Property="BorderBrush" Value="#D6DFEA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="TextBox:focus">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="BorderBrush" Value="#0F62FE" />
        </Style>

        <Style Selector="TextBox:pointerover">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#132235" />
        </Style>

        <Style Selector="TextBox /template/ ScrollViewer">
            <Setter Property="Background" Value="White" />
        </Style>

        <Style Selector="TextBox /template/ Border">
            <Setter Property="Background" Value="White" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="BorderBrush" Value="#D6DFEA" />
        </Style>

        <Style Selector="ComboBox:focus">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="BorderBrush" Value="#0F62FE" />
        </Style>

        <Style Selector="DatePicker">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="BorderBrush" Value="#D6DFEA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,8" />
        </Style>

        <Style Selector="DatePicker:focus">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="BorderBrush" Value="#0F62FE" />
        </Style>

        <Style Selector="DatePicker TextBlock">
            <Setter Property="Foreground" Value="#132235" />
        </Style>

        <Style Selector="Calendar">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#132235" />
        </Style>

        <Style Selector="Calendar /template/ Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D6DFEA" />
        </Style>

        <Style Selector="CalendarDayButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="CalendarDayButton:pointerover">
            <Setter Property="Background" Value="#EEF4FF" />
            <Setter Property="Foreground" Value="#0F62FE" />
            <Setter Property="BorderBrush" Value="#CFE0FF" />
        </Style>

        <Style Selector="CalendarDayButton:selected">
            <Setter Property="Background" Value="#0F62FE" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#0F62FE" />
        </Style>

        <Style Selector="CalendarDayButton:disabled">
            <Setter Property="Foreground" Value="#A4B1C0" />
        </Style>

        <Style Selector="CalendarButton">
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="CalendarButton:pointerover">
            <Setter Property="Background" Value="#EEF4FF" />
            <Setter Property="Foreground" Value="#0F62FE" />
        </Style>

        <Style Selector="DatePickerPresenter">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D6DFEA" />
        </Style>

        <Style Selector="PopupRoot">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#0F62FE" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#0F62FE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#0B57E3" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#0B57E3" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.primary:pressed">
            <Setter Property="Background" Value="#0847BC" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#0847BC" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.primary:disabled">
            <Setter Property="Background" Value="#9DBCFB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#9DBCFB" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.primary /template/ ContentPresenter">
            <Setter Property="TextElement.Foreground" Value="White" />
        </Style>

        <Style Selector="Button.primary /template/ Border">
            <Setter Property="Background" Value="#0F62FE" />
            <Setter Property="BorderBrush" Value="#0F62FE" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.primary:pointerover /template/ Border">
            <Setter Property="Background" Value="#0B57E3" />
            <Setter Property="BorderBrush" Value="#0B57E3" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.primary:pressed /template/ Border">
            <Setter Property="Background" Value="#0847BC" />
            <Setter Property="BorderBrush" Value="#0847BC" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="BorderBrush" Value="#D6DFEA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowHeight" Value="46" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
        </Style>

        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF3F9" />
            <Setter Property="Foreground" Value="#233143" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,10" />
        </Style>

        <Style Selector="DataGridRow">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#132235" />
        </Style>

        <Style Selector="DataGridRow:pointerover">
            <Setter Property="Background" Value="#F8FBFF" />
            <Setter Property="Foreground" Value="#132235" />
        </Style>

        <Style Selector="DataGridCell">
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#E8EEF5" />
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <Style Selector="DataGridCell:current">
            <Setter Property="Foreground" Value="#132235" />
            <Setter Property="Background" Value="#EEF4FF" />
        </Style>

        <Style Selector="DataGridCell TextBlock">
            <Setter Property="Foreground" Value="#132235" />
        </Style>
    </Window.Styles>

    <Grid>
        <Border x:Name="LoginView"
                Margin="28"
                Background="White"
                BorderBrush="#D9E2EC"
                BorderThickness="1"
                CornerRadius="10"
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="460">
            <StackPanel Spacing="18">
                <StackPanel Spacing="6">
                    <TextBlock Text="Giriş Yap"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#122033" />
                    <TextBlock Text="Email ve şifrenizle giriş yapın. Kayıtlı telefon numarası ile Yolcu360 oturumu açılır."
                               Foreground="#5F7187"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Email"
                               Foreground="#243446"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="LoginEmailTextBox"
                             PlaceholderText="mail@example.com" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Şifre"
                               Foreground="#243446"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="LoginPasswordTextBox"
                             PlaceholderText="Uygulama şifresi" />
                </StackPanel>

                <Button x:Name="LoginButton"
                        Classes="primary"
                        Content="Giriş Yap"
                        Click="LoginButton_Click" />

                <Button x:Name="GoToRegisterButton"
                        Content="Kayıt Ol"
                        Click="GoToRegisterButton_Click" />

                <TextBlock x:Name="StatusTextBlock"
                           Text="Hazır"
                           TextWrapping="Wrap"
                           Foreground="#132235"
                           FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <Border x:Name="RegisterView"
                IsVisible="False"
                Margin="28"
                Background="White"
                BorderBrush="#D9E2EC"
                BorderThickness="1"
                CornerRadius="10"
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="460">
            <StackPanel Spacing="18">
                <StackPanel Spacing="6">
                    <TextBlock Text="Kayıt Ol"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#122033" />
                    <TextBlock Text="Email, şifre ve telefon numarasıyla hesabınızı oluşturun."
                               Foreground="#5F7187"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Email"
                               Foreground="#243446"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="RegisterEmailTextBox"
                             PlaceholderText="mail@example.com" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Şifre"
                               Foreground="#243446"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="RegisterPasswordTextBox"
                             PlaceholderText="Uygulama şifresi" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Telefon numarası"
                               Foreground="#243446"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="RegisterPhoneNumberTextBox"
                             PlaceholderText="5xxxxxxxxx" />
                </StackPanel>

                <Button x:Name="RegisterButton"
                        Classes="primary"
                        Content="Kaydol ve Giriş Yap"
                        Click="RegisterButton_Click" />

                <Button x:Name="BackToLoginButton"
                        Content="Giriş Sayfasına Dön"
                        Click="BackToLoginButton_Click" />

                <TextBlock x:Name="RegisterStatusTextBlock"
                           Text=""
                           TextWrapping="Wrap"
                           Foreground="#132235"
                           FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="MainView"
                      IsVisible="False"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid Margin="28"
                  RowDefinitions="Auto,*"
                  RowSpacing="20">
                <Border Background="#0F172A"
                        CornerRadius="10"
                        Padding="28">
                    <Grid ColumnDefinitions="*"
                          ColumnSpacing="24">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Yolcu360 Operasyon Paneli"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="White" />

                            <TextBlock Text="Kayıtlı oturumla arama ve sonuç akışını yönetin."
                                       FontSize="15"
                                       Foreground="#C7D2E4" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1"
                      RowDefinitions="Auto,Auto,*"
                      RowSpacing="20">
                    <StackPanel Orientation="Horizontal"
                                Spacing="10">
                        <Button x:Name="SearchTabButton"
                                Classes="primary"
                                Content="Arama"
                                Width="160"
                                Click="SearchTabButton_Click" />
                        <Button x:Name="HistoryTabButton"
                                Content="Geçmiş Kayıtlar"
                                Width="180"
                                Click="HistoryTabButton_Click" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            x:Name="SearchPanel"
                            Background="White"
                            BorderBrush="#D9E2EC"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="22">
                        <StackPanel Spacing="18">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Arama ve Filtreleme"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#122033" />
                                <TextBlock Text="Alış noktası, tarih ve araç filtreleriyle sonuçları listeleyin."
                                           Foreground="#5F7187" />
                            </StackPanel>

                            <TextBlock x:Name="SearchStatusTextBlock"
                                       Text=""
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="#132235"
                                       FontWeight="SemiBold" />

                            <StackPanel Spacing="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Alış yeri"
                                               Foreground="#243446"
                                               FontWeight="SemiBold" />
                                    <TextBox x:Name="PickupLocationTextBox"
                                             PlaceholderText="Düzce" />
                                </StackPanel>

                                <Grid ColumnDefinitions="*,*"
                                      ColumnSpacing="14">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Alış tarihi"
                                                   Foreground="#243446"
                                                   FontWeight="SemiBold" />
                                        <TextBox x:Name="PickupDateTextBox"
                                                 PlaceholderText="2026-08-10" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Spacing="6">
                                        <TextBlock Text="Dönüş tarihi"
                                                   Foreground="#243446"
                                                   FontWeight="SemiBold" />
                                        <TextBox x:Name="ReturnDateTextBox"
                                                 PlaceholderText="2026-08-12" />
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="*,*"
                                      ColumnSpacing="14">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Alış saati"
                                                   Foreground="#243446"
                                                   FontWeight="SemiBold" />
                                        <TextBox x:Name="PickupTimeTextBox"
                                                 PlaceholderText="10:00" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Spacing="6">
                                        <TextBlock Text="Dönüş saati"
                                                   Foreground="#243446"
                                                   FontWeight="SemiBold" />
                                        <TextBox x:Name="ReturnTimeTextBox"
                                                 PlaceholderText="18:00" />
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,Auto"
                                      ColumnSpacing="8"
                                      HorizontalAlignment="Left">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Vites"
                                                   Foreground="#243446"
                                                   FontWeight="SemiBold" />
                                        <ComboBox x:Name="TransmissionComboBox"
                                                  Width="180"
                                                  SelectedIndex="0">
                                            <ComboBoxItem Content="Farketmez" Tag="" />
                                            <ComboBoxItem Content="Otomatik" Tag="otomatik" />
                                            <ComboBoxItem Content="Manuel" Tag="manuel" />
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Spacing="6">
                                        <TextBlock Text="Yakıt"
                                                   Foreground="#243446"
                                                   FontWeight="SemiBold" />
                                        <ComboBox x:Name="FuelComboBox"
                                                  Width="180"
                                                  SelectedIndex="0">
                                            <ComboBoxItem Content="Farketmez" Tag="" />
                                            <ComboBoxItem Content="Dizel" Tag="dizel" />
                                            <ComboBoxItem Content="Benzin" Tag="benzin" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="12">
                                <Button x:Name="SearchButton"
                                        Classes="primary"
                                        Content="Ara"
                                        Click="SearchButton_Click"
                                        Width="160" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2"
                            x:Name="SearchResultsPanel"
                            Background="White"
                            BorderBrush="#D9E2EC"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="22">
                        <Grid RowDefinitions="Auto,Auto,*"
                              RowSpacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Arama Sonuçları"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#122033" />
                                <TextBlock Text="Liste doğrudan tarayıcıdan okunan sonuçlarla güncellenir."
                                           Foreground="#5F7187" />
                            </StackPanel>

                            <Grid Grid.Row="1"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="12">
                                <TextBox x:Name="CollectionNameTextBox"
                                         PlaceholderText="Kaydetmek için özel isim girin" />
                                <Button Grid.Column="1"
                                        x:Name="SaveResultsButton"
                                        Classes="primary"
                                        Content="Kaydet"
                                        Width="140"
                                        Click="SaveResultsButton_Click" />
                            </Grid>

                            <Border Grid.Row="2"
                                    Background="#FBFDFF"
                                    BorderBrush="#E2EAF2"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="0">
                                <DataGrid x:Name="ResultsDataGrid"
                                          AutoGenerateColumns="True"
                                          IsReadOnly="True"
                                          CanUserResizeColumns="True"
                                          CanUserSortColumns="True"
                                          VerticalAlignment="Stretch"
                                          HorizontalAlignment="Stretch"
                                          MinHeight="420" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Grid.RowSpan="2"
                            x:Name="HistoryPanel"
                            IsVisible="False"
                            Background="White"
                            BorderBrush="#D9E2EC"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="22">
                        <Grid x:Name="HistoryExportRoot"
                              RowDefinitions="Auto,Auto,*,Auto,*"
                              RowSpacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Geçmiş Kayıtlar"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#122033" />
                                <TextBlock Text="Kaydedilen arama listelerini açın, silin veya PNG olarak indirin."
                                           Foreground="#5F7187" />
                            </StackPanel>

                            <TextBlock x:Name="HistoryStatusTextBlock"
                                       Grid.Row="1"
                                       Foreground="#132235"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />

                            <Border Grid.Row="2"
                                    Background="#FBFDFF"
                                    BorderBrush="#E2EAF2"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="0">
                                <DataGrid x:Name="CollectionsDataGrid"
                                          AutoGenerateColumns="True"
                                          IsReadOnly="True"
                                          CanUserResizeColumns="True"
                                          CanUserSortColumns="True"
                                          SelectionChanged="CollectionsDataGrid_SelectionChanged"
                                          MinHeight="220" />
                            </Border>

                            <StackPanel Grid.Row="3"
                                        Orientation="Horizontal"
                                        Spacing="12">
                                <Button x:Name="DeleteCollectionButton"
                                        Content="Sil"
                                        Width="120"
                                        Click="DeleteCollectionButton_Click" />
                                <Button x:Name="ExportPngButton"
                                        Classes="primary"
                                        Content="PNG Olarak İndir"
                                        Width="180"
                                        Click="ExportPngButton_Click" />
                            </StackPanel>

                            <Border Grid.Row="4"
                                    Background="#FBFDFF"
                                    BorderBrush="#E2EAF2"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="0">
                                <DataGrid x:Name="HistoryVehiclesDataGrid"
                                          AutoGenerateColumns="True"
                                          IsReadOnly="True"
                                          CanUserResizeColumns="True"
                                          CanUserSortColumns="True"
                                          MinHeight="260" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
